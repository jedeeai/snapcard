{
  "manifest_version": 3,
  "name": "SnapCard",
  "description": "一键把 X 推文变成分享卡片 | Turn any post on X into a beautiful shareable card",
  "version": "0.8.19",
  "homepage_url": "https://xbangdan.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["card.js", "render.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": [
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://translate.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
